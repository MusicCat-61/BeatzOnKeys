<Window x:Class="BeatzOnKeys.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeatzOnKeys"
        Width="680" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource DialogBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="6" Opacity="0.52"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="54" Height="54">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="Assets/BeatzOnKeys.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BeatzOnKeys" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="VersionText" FontSize="13.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseButtonStyle}" Width="32" Height="32"
                            Click="Close_Click" VerticalAlignment="Top" ToolTip="{DynamicResource L_CloseDialog}">
                        <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE8BB;" FontSize="12"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,20,0,18"/>

                <TextBlock Text="{DynamicResource About_Developer}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource About_Description}" FontSize="14.5" TextWrapping="Wrap"
                           LineHeight="22" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <WrapPanel Margin="0,15,0,0">
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,5" Margin="0,0,8,8"
                            Click="ProjectLink_Click" Content="{DynamicResource About_ProjectLink}"/>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,5" Margin="0,0,8,8"
                            Click="LicenseLink_Click" Content="{DynamicResource About_LicenseLink}"/>
                    <!-- Two different Telegram places: the program channel and the author. The
                         labels say which is which, because two bare links look interchangeable. -->
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,5" Margin="0,0,8,8"
                            Click="TelegramChannelLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource About_TelegramChannel}"/>
                            <TextBlock Text=" · t.me/beatzonkeys" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,5" Margin="0,0,8,8"
                            Click="TelegramLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource About_TelegramAuthor}"/>
                            <TextBlock Text=" · @music_cat1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,5" Margin="0,0,0,8"
                            Click="DonateLink_Click" Content="{DynamicResource About_Donate}"/>
                </WrapPanel>

                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,18"/>

                <TextBlock Text="{DynamicResource Upd_Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="UpdateStatusText" Text="{DynamicResource Upd_Idle}"
                           FontSize="14.5" TextWrapping="Wrap" LineHeight="22"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Height="6" Margin="0,13,0,0"/>

                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="UpdateCheckButton" Style="{StaticResource AccentButtonStyle}"
                            Content="{DynamicResource Upd_Check}" Click="UpdateCheck_Click"
                            MinWidth="174" Margin="0,0,8,8"/>
                    <Button x:Name="UpdateDownloadButton" Style="{StaticResource AccentButtonStyle}"
                            Content="{DynamicResource Upd_Download}" Click="UpdateDownload_Click"
                            MinWidth="174" Margin="0,0,8,8" Visibility="Collapsed"/>
                    <Button x:Name="UpdateInstallButton" Style="{StaticResource AccentButtonStyle}"
                            Content="{DynamicResource Upd_Install}" Click="UpdateInstall_Click"
                            MinWidth="190" Margin="0,0,8,8" Visibility="Collapsed"/>
                    <Button x:Name="UpdateReleaseButton" Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Upd_OpenRelease}" Click="UpdateRelease_Click"
                            MinWidth="174" Margin="0,0,0,8" Visibility="Collapsed"/>
                </WrapPanel>

                <Button Content="{DynamicResource L_CloseDialog}" Click="Close_Click"
                        Style="{StaticResource SubtleButtonStyle}" Width="126"
                        HorizontalAlignment="Right" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
