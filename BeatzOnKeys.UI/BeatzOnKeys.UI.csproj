<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>BeatzOnKeys.UI.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>BeatzOnKeys</AssemblyName>
    <RootNamespace>BeatzOnKeys.UI</RootNamespace>
    <Product>BeatzOnKeys</Product>
    <AssemblyTitle>BeatzOnKeys</AssemblyTitle>
    <Description>Turn typing into music.</Description>
    <Company>MusicCat-61</Company>
    <Authors>MusicCat-61</Authors>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <ApplicationIcon>Assets\BeatzOnKeys.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeatzOnKeys.Core\BeatzOnKeys.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BeatzOnKeys.png" />
    <Content Include="Assets\BeatzOnKeys.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
