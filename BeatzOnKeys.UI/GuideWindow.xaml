<Window x:Class="BeatzOnKeys.UI.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Guide_WindowTitle}"
        Width="840" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource DialogBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="6" Opacity="0.52"/>
        </Border.Effect>

        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource OverlayBrush}">
                    <TextBlock Text="&#xE897;" Style="{StaticResource SymbolIconStyle}" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Guide_WindowTitle}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource L_PlaybackSummary}" FontSize="13.5" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource CloseButtonStyle}" Width="32" Height="32"
                        Click="Close_Click" VerticalAlignment="Top" ToolTip="{DynamicResource L_CloseDialog}"
                        AutomationProperties.Name="{DynamicResource L_CloseDialog}">
                    <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE8BB;" FontSize="13"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,16,0,14"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="0,0,8,0">
                    <!-- Built in code so the Zapret block can sit inside the YouTube section. -->
                    <StackPanel x:Name="SectionsHost"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="3" Content="{DynamicResource L_CloseDialog}" Click="Close_Click"
                    Style="{StaticResource SubtleButtonStyle}" Width="126"
                    HorizontalAlignment="Right" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
