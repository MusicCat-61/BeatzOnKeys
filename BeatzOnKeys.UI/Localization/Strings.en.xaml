    <sys:String x:Key="L_Language">Interface language</sys:String>
    <sys:String x:Key="L_Theme">Light / dark theme</sys:String>
    <sys:String x:Key="L_Minimize">Minimize</sys:String>
    <sys:String x:Key="L_Maximize">Maximize or restore</sys:String>
    <sys:String x:Key="L_Close">Hide to tray</sys:String>
    <sys:String x:Key="L_DropTitle">Drop MP3 or WAV files here</sys:String>
    <sys:String x:Key="L_DropHint">Add tracks, press Start, then type to raise the volume</sys:String>
    <sys:String x:Key="L_AddFiles">Add files</sys:String>
    <sys:String x:Key="L_Tracks">Tracks</sys:String>
    <sys:String x:Key="L_TrackCountFormat">{0} tracks</sys:String>
