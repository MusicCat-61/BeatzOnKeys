    <sys:String x:Key="L_ResetTitle">Reset BeatzOnKeys?</sys:String>
    <sys:String x:Key="L_ResetMessage">This removes all tracks and saved settings. Your original audio files are not touched.</sys:String>
    <sys:String x:Key="L_Confirm">Reset</sys:String>
    <sys:String x:Key="L_Keep">Keep everything</sys:String>
    <sys:String x:Key="L_ResetComplete">BeatzOnKeys was reset.</sys:String>
    <sys:String x:Key="L_TrayOpen">Open BeatzOnKeys</sys:String>
    <sys:String x:Key="L_TrayStop">Stop playback</sys:String>
    <sys:String x:Key="L_TrayExit">Exit</sys:String>
    <sys:String x:Key="L_TrayText">BeatzOnKeys — typing becomes music</sys:String>
    <sys:String x:Key="L_FileDialogTitle">Choose audio tracks</sys:String>
    <sys:String x:Key="L_FileDialogFilter">Audio files (*.mp3;*.wav)|*.mp3;*.wav|MP3 files (*.mp3)|*.mp3|WAV files (*.wav)|*.wav</sys:String>
    <sys:String x:Key="L_About">About</sys:String>
    <sys:String x:Key="About_Title">About BeatzOnKeys</sys:String>
    <sys:String x:Key="About_Version">Version {0}</sys:String>
    <sys:String x:Key="About_Developer">BeatzOnKeys by MusicCat-61</sys:String>
    <sys:String x:Key="About_Description">Continuous MP3/WAV music that responds to typing: Start always plays from the beginning. Keys other than Shift, Ctrl and Alt raise volume to the maximum in 50 ms; after 150 ms without input it fades to the minimum over 200 ms. Optional idle pause (3 seconds by default) resumes instantly at the same position and maximum volume on the next key press.</sys:String>
    <sys:String x:Key="About_ProjectLink">BeatzOnKeys repository</sys:String>
    <sys:String x:Key="About_LicenseLink">MIT License and third-party notices</sys:String>
    <sys:String x:Key="About_Telegram">Telegram @music_cat1</sys:String>
    <sys:String x:Key="About_Donate">Support the project</sys:String>
