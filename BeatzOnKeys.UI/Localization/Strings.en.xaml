    <sys:String x:Key="Upd_Check">Check for updates</sys:String>
    <sys:String x:Key="Upd_Download">Download {0}</sys:String>
    <sys:String x:Key="Upd_Downloading">Downloading and verifying… {0}%</sys:String>
    <sys:String x:Key="Upd_Ready">Version {0} is verified and ready to install.</sys:String>
    <sys:String x:Key="Upd_Install">Install and restart</sys:String>
    <sys:String x:Key="Upd_OpenRelease">Open release page</sys:String>
    <sys:String x:Key="Upd_NotWritable">The application folder is not writable: {0}. Move BeatzOnKeys to a writable folder.</sys:String>
    <sys:String x:Key="Upd_DownloadFailed">The update could not be prepared. {0}</sys:String>
    <sys:String x:Key="Upd_Applying">Closing BeatzOnKeys to install the verified update…</sys:String>
