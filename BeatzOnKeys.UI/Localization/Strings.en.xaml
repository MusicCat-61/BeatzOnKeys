    <sys:String x:Key="L_Remove">Remove</sys:String>
    <sys:String x:Key="L_Settings">Playback settings</sys:String>
    <sys:String x:Key="L_MaxVolume">Maximum volume</sys:String>
    <sys:String x:Key="L_MaxVolumeHint">Typing raises the volume to this limit in 50 ms. Default: 100%.</sys:String>
    <sys:String x:Key="L_MinVolume">Minimum volume</sys:String>
    <sys:String x:Key="L_MinVolumeHint">Default: 20%. The actual minimum cannot exceed the maximum; both limits are saved independently.</sys:String>
    <sys:String x:Key="L_IdleTimeout">Idle timeout</sys:String>
    <sys:String x:Key="L_IdleTimeoutSecondsFormat">{0} s</sys:String>
    <sys:String x:Key="L_PauseOnIdle">Pause when idle</sys:String>
    <sys:String x:Key="L_IdleTimeoutHint">Enabled by default: pause after this many seconds without typing (default: 3 s). The next key press instantly resumes at the same position and maximum volume.</sys:String>
    <sys:String x:Key="L_PlaybackHint">Start plays continuously from the beginning. Every key except Shift, Ctrl and Alt raises volume in 50 ms; after 150 ms without input, it fades to the minimum over 200 ms.</sys:String>
    <sys:String x:Key="L_PlaybackSummary">Music plays continuously; typing controls its volume.</sys:String>
    <sys:String x:Key="L_StartHint">Play the selected track from the beginning and hide to the tray.</sys:String>
    <sys:String x:Key="L_StopHint">Stop music and keyboard monitoring. The next Start plays from the beginning.</sys:String>
    <sys:String x:Key="L_AutoAdvance">Auto-advance tracks</sys:String>
    <sys:String x:Key="L_AutoAdvanceHint">Move to the next available track when the current one ends</sys:String>
    <sys:String x:Key="L_Loop">Loop playback</sys:String>
    <sys:String x:Key="L_LoopHint">Repeat the current track without auto-advance, or the whole list when auto-advance is on</sys:String>
    <sys:String x:Key="L_SelectedTrack">Selected track</sys:String>
    <sys:String x:Key="L_NoTrackSelected">Select an available track</sys:String>
    <sys:String x:Key="L_PlaybackProgress">Playback position</sys:String>
    <sys:String x:Key="L_PrivacyTitle">Private by design</sys:String>
    <sys:String x:Key="L_PrivacyText">The keyboard hook receives only a key-down signal. Typed characters and window names are never read or logged.</sys:String>
    <sys:String x:Key="L_Start">Start</sys:String>
    <sys:String x:Key="L_Stop">Stop</sys:String>
