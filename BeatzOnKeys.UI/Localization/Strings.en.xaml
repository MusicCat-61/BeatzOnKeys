    <sys:String x:Key="About_Title">About BeatzOnKeys</sys:String>
    <sys:String x:Key="About_Version">Version {0}</sys:String>
    <sys:String x:Key="About_Developer">BeatzOnKeys by MusicCat-61</sys:String>
    <sys:String x:Key="About_Description">Continuous MP3/WAV music that responds to typing: Start always plays from the beginning. Keys other than Shift, Ctrl and Alt raise volume to the maximum in 50 ms; after 150 ms without input it fades to the minimum over 200 ms. Optional idle pause (3 seconds by default) resumes instantly at the same position and maximum volume on the next key press.</sys:String>
