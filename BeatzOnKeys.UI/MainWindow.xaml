<Window x:Class="BeatzOnKeys.UI.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:BeatzOnKeys.UI.Converters"
        mc:Ignorable="d"
        Title="BeatzOnKeys"
        Width="1120" Height="780" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:TrackStatusBrushConverter x:Key="TrackStatusBrushConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/BeatzOnKeys.png" Width="25" Height="25"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_AppName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource L_AppTagline}" FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,-1,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="2" Margin="0,0,10,0"
                        ToolTip="{DynamicResource L_Language}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LangButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="RU" Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LangButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRussian}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleThemeCommand}"
                        ToolTip="{DynamicResource L_Theme}" Margin="0,0,4,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE706;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                        <Setter Property="Text" Value="&#xE708;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MinimizeClick"
                        ToolTip="{DynamicResource L_Minimize}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MaximizeClick"
                        ToolTip="{DynamicResource L_Maximize}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="CloseClick"
                        ToolTip="{DynamicResource L_Close}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,6,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="DropBorder" Grid.Row="0" Style="{StaticResource CardStyle}"
                        Background="{DynamicResource DropAreaBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        DragEnter="DropBorder_DragEnter" DragOver="DropBorder_DragOver"
                        DragLeave="DropBorder_DragLeave" Drop="DropBorder_Drop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="9"
                                        Background="{DynamicResource OverlayBrush}" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_DropTitle}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource L_DropHint}" FontSize="13.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                            <Button Content="{DynamicResource L_AddFiles}" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding AddFilesCommand}" MinWidth="154" Margin="0,0,0,8"/>
                            <Button Content="{DynamicResource L_ProcessAll}" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding ProcessAllCommand}" MinWidth="154"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,12,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,4,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Tracks}" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                                <TextBlock Text="{Binding TrackCountText}" FontSize="13" Margin="10,1,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource L_Cancel}"
                                    Command="{Binding CancelProcessingCommand}" Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource TrackListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTracks}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding TooltipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="7" VerticalAlignment="Center"
                                                    Background="{DynamicResource OverlayBrush}">
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>

                                            <Grid Grid.Column="1" Margin="4,0,12,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding FileName}" FontSize="14.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource TrackStatusBrushConverter}}"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding StatusDetails}" FontSize="12.5" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </StackPanel>
                                                <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,7,0,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </Grid>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                                        Padding="6,3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Extension}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </Border>
                                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                                        Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="{DynamicResource L_Remove}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTracks}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Text="{DynamicResource L_EmptyTracks}" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="{DynamicResource L_EmptyTracksHint}" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings}" Style="{StaticResource SectionLabelStyle}"/>

                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                            <TextBlock Text="{DynamicResource L_Volume}" Style="{StaticResource ValueLabelStyle}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" TickFrequency="0.01" Margin="0,4,0,0"/>

                        <DockPanel Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackSpeedText}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                            <TextBlock Text="{DynamicResource L_PlaybackSpeed}" Style="{StaticResource ValueLabelStyle}"/>
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="2" Value="{Binding PlaybackSpeed}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,15,0,13"/>
                        <CheckBox Content="{DynamicResource L_AutoAdvance}" IsChecked="{Binding AutoAdvance}"/>
                        <TextBlock Text="{DynamicResource L_AutoAdvanceHint}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="30,5,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource DropAreaBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_SelectedTrack}" FontSize="12.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding SelectedTrackText}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="15" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L_PrivacyTitle}" FontSize="14.5" FontWeight="SemiBold"
                                       Margin="9,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L_PrivacyText}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="0,9,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="AboutClick" Style="{StaticResource SubtleButtonStyle}" Padding="10,5"
                        AutomationProperties.Name="{DynamicResource L_About}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_About}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenLogsCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="10,5"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_Logs}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="ResetClick" Style="{StaticResource DangerButtonStyle}" Padding="10,5"
                        Margin="8,0,0,0" IsEnabled="{Binding CanReset}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        <TextBlock Text="{DynamicResource L_Reset}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding NowPlayingText}" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource L_Stop}" Command="{Binding StopCommand}"
                        Style="{StaticResource SubtleButtonStyle}" MinWidth="108" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource L_Start}" Command="{Binding StartCommand}"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="138"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
