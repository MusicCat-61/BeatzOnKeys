<Window x:Class="BeatzOnKeys.UI.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BeatzOnKeys"
        Width="1120" Height="780" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="26" Height="26">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="Assets/BeatzOnKeys.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_AppName}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource L_AppTagline}" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,-1,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- The tabs are gone: the start screen chooses the source, and every mode carries
                 one way back to it. A screen without an exit is a trap, so the way home is on
                 screen in all of them. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"
                        HorizontalAlignment="Left"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Command="{Binding ShowHomeCommand}" Visibility="{Binding HomeButtonVisible}"
                        Background="Transparent" BorderThickness="0" Padding="8,5"
                        Cursor="Hand" ToolTip="{DynamicResource L_HomeHint}"
                        AutomationProperties.Name="{DynamicResource L_Home}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource SymbolIconStyle}" FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource L_Home}" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding CurrentModeTitle}" FontSize="15" FontWeight="SemiBold"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding ModeTitleVisible}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="2" Margin="0,0,10,0"
                        ToolTip="{DynamicResource L_Language}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LangButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="RU" Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LangButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRussian}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButtonStyle}" Click="GuideClick"
                        ToolTip="{DynamicResource L_Guide}" Margin="0,0,4,0"
                        AutomationProperties.Name="{DynamicResource L_Guide}">
                    <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE897;"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleThemeCommand}"
                        ToolTip="{DynamicResource L_Theme}" Margin="0,0,4,0">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIconStyle}">
                                <Setter Property="Text" Value="&#xE706;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                        <Setter Property="Text" Value="&#xE708;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MinimizeClick"
                        ToolTip="{DynamicResource L_Minimize}">
                    <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE921;"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MaximizeClick"
                        ToolTip="{DynamicResource L_Maximize}">
                    <TextBlock x:Name="MaximizeIcon" Style="{StaticResource SymbolIconStyle}" Text="&#xE922;"/>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="CloseClick"
                        ToolTip="{DynamicResource L_Close}">
                    <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE8BB;"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPlaylistPage}" Value="True"/>
                                <Condition Binding="{Binding IsFocusMode}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="138"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="DropBorder" Grid.Row="0" Style="{StaticResource CardStyle}"
                        Background="{DynamicResource DropAreaBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        DragEnter="DropBorder_DragEnter" DragOver="DropBorder_DragOver"
                        DragLeave="DropBorder_DragLeave" Drop="DropBorder_Drop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{DynamicResource OverlayBrush}" Margin="0,0,13,0">
                                <TextBlock Text="&#xE898;" Style="{StaticResource SymbolIconStyle}" FontSize="20"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_DropTitle}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource L_DropHint}" FontSize="14.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Button Grid.Column="1" Content="{DynamicResource L_AddFiles}"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding AddFilesCommand}" MinWidth="148"
                                VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,12,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="2,0,4,9" VerticalAlignment="Center" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Click="ClearPlaylistClick" Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,3" Margin="8,0,0,0" ToolTip="{DynamicResource L_ClearPlaylistHint}"
                                    IsEnabled="{Binding CanClearPlaylist}"
                                    AutomationProperties.Name="{DynamicResource L_ClearPlaylist}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIconStyle}" FontSize="13"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_ClearPlaylist}" VerticalAlignment="Center" FontSize="13.5"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{DynamicResource L_Tracks}" Style="{StaticResource SectionLabelStyle}"
                                       Margin="0" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Height="26" MinWidth="26" CornerRadius="13"
                                    Background="{DynamicResource DropAreaBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding TrackCountText}"
                                    AutomationProperties.Name="{Binding TrackCountText}">
                                <TextBlock Text="{Binding TrackCountNumber}" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- The filter narrows the view only: the counter above keeps counting every
                             track, and the drag order still works on the real list. -->
                        <Grid Grid.Row="1" Margin="2,0,4,10">
                            <TextBox Text="{Binding TrackFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}" MaxLength="200"
                                     AcceptsReturn="False" Padding="34,5,34,5"
                                     AutomationProperties.Name="{DynamicResource L_SearchTracksHint}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIconStyle}" FontSize="13"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="11,0,0,0" IsHitTestVisible="False"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                    Style="{StaticResource FieldClearButtonStyle}"
                                    Command="{Binding ClearTrackFilterCommand}"
                                    Visibility="{Binding TrackFilterClearVisible}"
                                    ToolTip="{DynamicResource L_ClearInput}"
                                    AutomationProperties.Name="{DynamicResource L_ClearInput}">
                                <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE711;"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding FilteredTracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource TrackListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="Playlist_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="Playlist_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="Playlist_PreviewMouseLeftButtonUp"
                                     DragOver="Playlist_DragOver"
                                     DragLeave="Playlist_DragLeave"
                                     Drop="Playlist_Drop">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTracks}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding TooltipText}" MinHeight="42">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.52"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Insertion line shown while a row is dragged over this one. -->
                                            <Border Grid.ColumnSpan="7" Height="2" CornerRadius="1"
                                                    VerticalAlignment="Top" Margin="-8,-6,-8,0"
                                                    Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDropTarget}" Value="True"/>
                                                                    <Condition Binding="{Binding IsDropTargetAbove}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border Grid.ColumnSpan="7" Height="2" CornerRadius="1"
                                                    VerticalAlignment="Bottom" Margin="-8,0,-8,-6"
                                                    Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDropTarget}" Value="True"/>
                                                                    <Condition Binding="{Binding IsDropTargetAbove}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Border Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center"
                                                    Background="{DynamicResource OverlayBrush}">
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}" FontSize="16"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>

                                            <Grid Grid.Column="1" Margin="5,0,12,0" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding FileName}" FontSize="15.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding DirectoryName}" FontSize="13"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="&#xE823;" Style="{StaticResource SymbolIconStyle}" FontSize="13"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding DurationText}" FontSize="13.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Border Grid.Column="3" Background="{DynamicResource ControlBackgroundBrush}"
                                                    CornerRadius="4" Padding="6,3" Margin="0,0,7,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </Border>
                                            <Button Grid.Column="4" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource L_MoveUp}"
                                                    AutomationProperties.Name="{DynamicResource L_MoveUp}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                        <Setter Property="Width" Value="26"/>
                                                        <Setter Property="Height" Value="26"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE70E;"/>
                                            </Button>
                                            <Button Grid.Column="5" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource L_MoveDown}"
                                                    AutomationProperties.Name="{DynamicResource L_MoveDown}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                        <Setter Property="Width" Value="26"/>
                                                        <Setter Property="Height" Value="26"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE70D;"/>
                                            </Button>
                                            <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                                    Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource L_Remove}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIconStyle}" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTracks}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}" FontSize="30"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Text="{DynamicResource L_EmptyTracks}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="{DynamicResource L_EmptyTracksHint}" FontSize="15" Margin="0,4,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <!-- A filter that hides everything is not an empty playlist, and the
                                 hint says which of the two happened. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                        Visibility="{Binding TrackFilteredEmptyVisibility}">
                                <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIconStyle}" FontSize="26"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Text="{DynamicResource L_SearchNoMatch}" FontSize="17" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" x:Name="PlayerScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource DropAreaBrush}">
                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}" FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlayingSourceText}" FontSize="14.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding PlayingTrackText}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,13,0,11"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackPositionText}"
                                           FontSize="14.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource L_PlaybackProgress}" FontSize="14.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </DockPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding PlaybackProgress, Mode=OneWay}"
                                         Height="5" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource SymbolIconStyle}" FontSize="17"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource L_PrivacyTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L_PrivacyText}" FontSize="14.5" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The playback panel floats above the active tab, so that tab keeps its content
             visible; the card itself is opaque so its text never mixes with what is behind. -->
        <Grid Grid.Row="1" Panel.ZIndex="10" Margin="20,4,20,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSettingsOpen}" Value="True"/>
                                <Condition Binding="{Binding IsFocusMode}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border HorizontalAlignment="Right" Width="392" Background="{DynamicResource SettingsPanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,12,10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                Command="{Binding CloseSettingsCommand}" ToolTip="{DynamicResource L_CloseDialog}"
                                AutomationProperties.Name="{DynamicResource L_CloseDialog}">
                            <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="13" Text="&#xE8BB;"/>
                        </Button>
                        <TextBlock Text="{DynamicResource L_Settings}" Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="16,0,10,14">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource SettingsChipStyle}"
                                              Content="{DynamicResource L_ChipVolume}"
                                              IsChecked="{Binding IsVolumeChipActive, Mode=OneWay}"
                                              Click="VolumeChipClick"/>
                                <ToggleButton Style="{StaticResource SettingsChipStyle}" Margin="6,0,0,0"
                                              Content="{DynamicResource L_ChipReaction}"
                                              IsChecked="{Binding IsReactionChipActive, Mode=OneWay}"
                                              Click="ReactionChipClick"/>
                                <ToggleButton Style="{StaticResource SettingsChipStyle}" Margin="6,0,0,0"
                                              Content="{DynamicResource L_ChipBehavior}"
                                              IsChecked="{Binding IsBehaviorChipActive, Mode=OneWay}"
                                              Click="BehaviorChipClick"/>
                            </StackPanel>

                            <Border x:Name="VolumeSection">
                                <StackPanel>
                                    <Button Style="{StaticResource SettingsSectionHeaderStyle}" Click="VolumeHeaderClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsChevronStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVolumeExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource L_VolumeSection}"
                                                       Style="{StaticResource SettingsSectionTitleStyle}"/>
                                            <Border Grid.Column="2">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource SettingsCountBadgeStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVolumeExpanded}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="4" Style="{StaticResource SettingsCountBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding VolumeSummary}"
                                                       Style="{StaticResource SettingsSectionSummaryStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>

                                    <StackPanel Margin="14,2,0,2">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVolumeExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaxVolumePercent}"
                                                       Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock Text="{DynamicResource L_MaxVolume}" Style="{StaticResource ValueLabelStyle}"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="100"
                                                Value="{Binding MaxVolumePercentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource L_MaxVolumeHint}"
                                                TickFrequency="1" Margin="0,4,0,0"/>

                                        <DockPanel Margin="0,12,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MinVolumePercent}"
                                                       Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock Text="{DynamicResource L_MinVolume}" Style="{StaticResource ValueLabelStyle}"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="50"
                                                Value="{Binding MinVolumePercentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource L_MinVolumeHint}"
                                                TickFrequency="1" Margin="0,4,0,0"/>

                                        <DockPanel Margin="0,12,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding IdleTimeoutText}"
                                                       Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock Text="{DynamicResource L_IdleTimeout}" Style="{StaticResource ValueLabelStyle}"/>
                                        </DockPanel>
                                        <Slider Minimum="1" Maximum="10"
                                                Value="{Binding IdleTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource L_IdleTimeoutHint}"
                                                TickFrequency="0.1" SmallChange="0.1" LargeChange="1"
                                                IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

                                        <CheckBox IsChecked="{Binding PauseOnIdle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{DynamicResource L_IdleTimeoutHint}" Margin="0,10,0,4">
                                            <TextBlock Text="{DynamicResource L_PauseOnIdle}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,6,0,4"/>

                            <Border x:Name="ReactionSection">
                                <StackPanel>
                                    <Button Style="{StaticResource SettingsSectionHeaderStyle}" Click="ReactionHeaderClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsChevronStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReactionExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource L_ReactionSection}"
                                                       Style="{StaticResource SettingsSectionTitleStyle}"/>
                                            <Border Grid.Column="2">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource SettingsCountBadgeStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReactionExpanded}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="4" Style="{StaticResource SettingsCountBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding ReactionSummary}"
                                                       Style="{StaticResource SettingsSectionSummaryStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>

                                    <StackPanel Margin="14,2,0,2">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReactionExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <CheckBox IsChecked="{Binding PunchResponseEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{DynamicResource L_PunchResponseHint}" Margin="0,2,0,0">
                                            <TextBlock Text="{DynamicResource L_PunchResponse}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource L_PunchResponseHint}" FontSize="14" TextWrapping="Wrap"
                                                   Margin="30,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>

                                        <DockPanel Margin="0,12,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BassReactivePercent}"
                                                       Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock Text="{DynamicResource L_BassGain}" Style="{StaticResource ValueLabelStyle}"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30"
                                                Value="{Binding BassReactivePercentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource L_BassGainHint}"
                                                TickFrequency="1" Margin="0,4,0,0"/>
                                        <TextBlock Text="{DynamicResource L_BassGainHint}" FontSize="14" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>

                                        <CheckBox IsChecked="{Binding StereoPulseEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{DynamicResource L_StereoPulseHint}" Margin="0,10,0,0">
                                            <TextBlock Text="{DynamicResource L_StereoPulse}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource L_StereoPulseHint}" FontSize="14" TextWrapping="Wrap"
                                                   Margin="30,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>

                                        <CheckBox IsChecked="{Binding AdaptiveVolumeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{DynamicResource L_AdaptiveVolumeHint}" Margin="0,10,0,0">
                                            <TextBlock Text="{DynamicResource L_AdaptiveVolume}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource L_AdaptiveVolumeHint}" FontSize="14" TextWrapping="Wrap"
                                                   Margin="30,4,0,4" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,6,0,4"/>

                            <Border x:Name="BehaviorSection">
                                <StackPanel>
                                    <Button Style="{StaticResource SettingsSectionHeaderStyle}" Click="BehaviorHeaderClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsChevronStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBehaviorExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource L_BehaviorSection}"
                                                       Style="{StaticResource SettingsSectionTitleStyle}"/>
                                            <Border Grid.Column="2">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource SettingsCountBadgeStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBehaviorExpanded}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="2" Style="{StaticResource SettingsCountBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding BehaviorSummary}"
                                                       Style="{StaticResource SettingsSectionSummaryStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>

                                    <StackPanel Margin="14,2,0,2">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBehaviorExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <CheckBox IsChecked="{Binding AutoAdvance}" Margin="0,2,0,0">
                                            <TextBlock Text="{DynamicResource L_AutoAdvance}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource L_AutoAdvanceHint}" FontSize="14" TextWrapping="Wrap"
                                                   Margin="30,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>

                                        <CheckBox IsChecked="{Binding Loop}" Margin="0,10,0,0">
                                            <TextBlock Text="{DynamicResource L_Loop}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource L_LoopHint}" FontSize="14" TextWrapping="Wrap"
                                                   Margin="30,4,0,4" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
            </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsYouTubePage}" Value="True"/>
                                <Condition Binding="{Binding IsFocusMode}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding YouTube.StatusText}" FontSize="15" TextWrapping="Wrap"
                               Margin="2,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel>
                            <DockPanel>
                                <!-- The label lives in the style, so the button must not hold any content of
                                     its own: a local child would outrank the setter and leave the button
                                     empty, which is exactly what a nested Cancel button did. -->
                                <Button DockPanel.Dock="Right" MinWidth="112" Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                            <Setter Property="Content" Value="{DynamicResource L_YtSearch}"/>
                                            <Setter Property="Command" Value="{Binding YouTube.SearchCommand}"/>
                                            <Style.Triggers>
                                                <!-- A pasted link can only be downloaded, words can only be searched. -->
                                                <DataTrigger Binding="{Binding YouTube.QueryIsLink}" Value="True">
                                                    <!-- The hint says "press Download", so the button must say the same. -->
                                                    <Setter Property="Content" Value="{DynamicResource L_YtDownloadNow}"/>
                                                    <Setter Property="Command" Value="{Binding YouTube.DownloadFromQueryCommand}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Cancel is a neighbour of that button, not its content: it appears only
                                     while something runs — a search, the background cache pass or a link
                                     download — and must not take the label away when it hides. -->
                                <Button DockPanel.Dock="Right" MinWidth="96" Margin="8,0,0,0"
                                        Content="{DynamicResource L_Cancel}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding YouTube.CancelCommand}"
                                        Visibility="{Binding YouTube.CancelVisible}"/>
                                <Grid>
                                    <TextBox Text="{Binding YouTube.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBoxStyle}" MaxLength="200"
                                             AcceptsReturn="False" Padding="10,6,36,6"
                                             AutomationProperties.Name="{DynamicResource L_YtSearchPlaceholder}"/>
                                    <!-- The cross clears the field itself; nothing else happens. -->
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                            Style="{StaticResource FieldClearButtonStyle}"
                                            Command="{Binding YouTube.ClearQueryCommand}"
                                            Visibility="{Binding YouTube.QueryClearVisible}"
                                            ToolTip="{DynamicResource L_ClearInput}"
                                            AutomationProperties.Name="{DynamicResource L_ClearInput}">
                                        <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE711;"/>
                                    </Button>
                                </Grid>
                            </DockPanel>
                            <ProgressBar Value="{Binding YouTube.InstallProgress, Mode=OneWay}" Maximum="1"
                                         Height="4" Margin="0,10,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding YouTube.IsInstalling}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <!-- One row that covers both field actions: a spinner while words are
                                 searched, a real percentage while a pasted link downloads. -->
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding YouTube.ShowQueryActivity}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Height="4" Maximum="1">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="IsIndeterminate" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding YouTube.IsQueryDownloading}" Value="True">
                                                    <Setter Property="IsIndeterminate" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                    <ProgressBar.Value>
                                        <Binding Path="YouTube.QueryProgress" Mode="OneWay"/>
                                    </ProgressBar.Value>
                                </ProgressBar>
                                <TextBlock FontSize="14" Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource L_YtSearching}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding YouTube.IsQueryDownloading}" Value="True">
                                                    <Setter Property="Text" Value="{Binding YouTube.QueryProgressText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- The same composite as "Downloaded from TikTok": a heading with a
                                 round badge that carries the count, so the number sits next to the
                                 list it describes instead of in a sentence above it. -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock Text="{DynamicResource L_YtFoundTitle}" FontSize="16"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Margin="10,0,0,0" Height="26" MinWidth="26" CornerRadius="13"
                                        Background="{DynamicResource DropAreaBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        Visibility="{Binding YouTube.ResultsBadgeVisible}"
                                        AutomationProperties.Name="{Binding YouTube.ResultsCountNumber}">
                                    <TextBlock Text="{Binding YouTube.ResultsCountNumber}" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding YouTube.Results}" Background="Transparent"
                                 BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource TrackListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Listen sits left of the title and only works once the result is cached. -->
                                        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                                                Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"
                                                ToolTip="{Binding PreviewTooltip}"
                                                AutomationProperties.Name="{Binding PreviewTooltip}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.YouTube.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <!-- A round backing makes the glyph read as a player button, not a stray icon. -->
                                            <Border Width="30" Height="30" CornerRadius="15">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanPlay}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PlayGlyph}" FontSize="12.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanPlay}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Button>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                                           FontSize="13.5" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding CacheStateText}" FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3" Margin="0,6,0,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="13.5"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <!-- Adding waits for the preview: the row must not start a
                                             second download behind the user's back. Once the track
                                             is saved the button turns into a green check and stops
                                             accepting clicks, so a second press cannot re-download. -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="104">
                                            <Button Content="{DynamicResource L_YtDownloadLink}"
                                                    IsEnabled="{Binding CanAdd}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.YouTube.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Border Height="30" CornerRadius="5" BorderThickness="1"
                                                    BorderBrush="{DynamicResource SuccessBrush}"
                                                    Background="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="&#xE73E;" FontSize="12.5"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               FontFamily="Segoe MDL2 Assets"/>
                                                    <TextBlock Text="{DynamicResource L_YtAdded}" FontSize="13.5"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- An empty list needs a sentence. A cleared list and a failed search say
                             different things: blaming the query for a deliberate clear would read as
                             a bug. Both sit under the list, not over it. -->
                        <TextBlock Grid.Row="1" Text="{DynamicResource L_YtResultsCleared}"
                                   FontSize="16" TextWrapping="Wrap" Margin="2,10,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding YouTube.ResultsClearedHintVisible}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource L_YtResultsEmpty}"
                                   FontSize="16" TextWrapping="Wrap" Margin="2,10,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding YouTube.EmptyResultsVisible}"/>
<!-- While a search runs the empty area becomes a small piano scene: a ring turns,
                             a light sweeps across the keys and two notes drift up. Every colour comes
                             from the theme, and nothing is a picture asset, so it scales with DPI. -->
                        <Grid Grid.Row="1" x:Name="SearchAnimation" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding YouTube.IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- The ring turns: the only motion that says "working" without a bar. -->
                                <Grid Width="132" Height="132" HorizontalAlignment="Center">
                                    <Ellipse Width="132" Height="132" Stroke="{DynamicResource OverlayBrush}"
                                             StrokeThickness="2" Opacity="0.7"/>
                                    <Ellipse Width="132" Height="132" Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="3" StrokeDashArray="1.5 7" StrokeDashCap="Round">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform CenterX="66" CenterY="66"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YouTube.IsSearching}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SearchRingSpin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                        From="0" To="360" Duration="0:0:1.8"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SearchRingSpin"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="♫" FontSize="34" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                               Opacity="0.85">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="0" Y="0"/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YouTube.IsSearching}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SearchHeartbeat">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        From="0.35" To="0.95" Duration="0:0:0.9"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SearchHeartbeat"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="{DynamicResource L_YtSearching}" FontSize="14" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <!-- A canvas instead of two stacked panels: the black keys sit on the
                                     boundaries between white ones, which is what makes it read as a
                                     keyboard rather than two rows of bars. -->
                                <Canvas Width="176" Height="56" Margin="0,16,0,0" HorizontalAlignment="Center">
                                    <Rectangle Canvas.Left="0" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="22" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="44" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="66" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="88" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="110" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="132" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>
                                    <Rectangle Canvas.Left="154" Width="20" Height="56" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource OverlayBrush}"
                                               Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"/>

                                    <!-- Two gaps on purpose: a keyboard without them is just a fence. -->
                                    <Rectangle Canvas.Left="14" Width="12" Height="34" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Rectangle Canvas.Left="36" Width="12" Height="34" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Rectangle Canvas.Left="80" Width="12" Height="34" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Rectangle Canvas.Left="102" Width="12" Height="34" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Rectangle Canvas.Left="124" Width="12" Height="34" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TextTertiaryBrush}"/>

                                    <!-- One sweeping light instead of eight animations, and it reads as a
                                         hand moving along the keys. -->
                                    <Rectangle Width="26" Height="56" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource AccentBrush}" Opacity="0.5">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform X="-40"/>
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YouTube.IsSearching}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SearchKeySweep">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                        From="-30" To="180" Duration="0:0:2.6"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SearchKeySweep"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Canvas>

                                <!-- Two notes drift up and fade, so the scene has a direction of motion. -->
                                <Canvas Width="176" Height="30" Margin="0,2,0,0" HorizontalAlignment="Center">
                                    <TextBlock Canvas.Left="52" Text="♪" FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}" Opacity="0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="0" Y="6"/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YouTube.IsSearching}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SearchNoteOne">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                        From="10" To="-16" Duration="0:0:2.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        From="0" To="1" Duration="0:0:0.9"
                                                                        AutoReverse="True"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SearchNoteOne"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Canvas.Left="104" Canvas.Top="6" Text="♫" FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="0" Y="6"/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YouTube.IsSearching}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SearchNoteTwo">
                                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.1">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                        From="10" To="-16" Duration="0:0:2.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        From="0" To="0.9" Duration="0:0:1.0"
                                                                        AutoReverse="True"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SearchNoteTwo"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Canvas>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="10" MaxHeight="280">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                            <TextBlock Text="{DynamicResource L_YtDownloadedTitle}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Height="26" MinWidth="26" CornerRadius="13"
                                    Background="{DynamicResource DropAreaBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding YouTube.TrackCountNumber}" FontSize="16"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <!-- The filter narrows the view only: the counter above keeps counting every
                             downloaded track, and clearing still clears them all. -->
                        <Grid Grid.Row="1" Margin="2,0,0,8">
                            <TextBox Text="{Binding YouTube.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}" MaxLength="200"
                                     AcceptsReturn="False" Padding="34,5,34,5"
                                     AutomationProperties.Name="{DynamicResource L_SearchTracksHint}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIconStyle}" FontSize="13"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="11,0,0,0" IsHitTestVisible="False"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                    Style="{StaticResource FieldClearButtonStyle}"
                                    Command="{Binding YouTube.ClearFilterCommand}"
                                    Visibility="{Binding YouTube.FilterClearVisible}"
                                    ToolTip="{DynamicResource L_ClearInput}"
                                    AutomationProperties.Name="{DynamicResource L_ClearInput}">
                                <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE711;"/>
                            </Button>
                        </Grid>
                        <ListBox Grid.Row="2" ItemsSource="{Binding YouTube.FilteredDownloaded}" Background="Transparent"
                                 SelectedItem="{Binding YouTube.SelectedTrack, Mode=TwoWay}"
                                 BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource TrackListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="YouTubeList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="YouTubeList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="YouTubeList_PreviewMouseLeftButtonUp"
                                 DragOver="YouTubeList_DragOver"
                                 DragLeave="YouTubeList_DragLeave"
                                 Drop="YouTubeList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48" ToolTip="{Binding TooltipText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.ColumnSpan="7" Height="2" CornerRadius="1"
                                                VerticalAlignment="Top" Margin="-8,-6,-8,0"
                                                Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDropTarget}" Value="True"/>
                                                                <Condition Binding="{Binding IsDropTargetAbove}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border Grid.ColumnSpan="7" Height="2" CornerRadius="1"
                                                VerticalAlignment="Bottom" Margin="-8,0,-8,-6"
                                                Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDropTarget}" Value="True"/>
                                                                <Condition Binding="{Binding IsDropTargetAbove}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Width="30" Height="30" CornerRadius="7" VerticalAlignment="Center"
                                                Background="{DynamicResource OverlayBrush}">
                                            <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}"
                                                       FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SubtitleText}" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding SubtitleVisible}"/>
                                            <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3"
                                                         Margin="0,6,0,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="13.5"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <Border Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                                                CornerRadius="4" Padding="6,2" BorderThickness="1"
                                                Visibility="{Binding StatusChipVisible}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChipReady}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChipFailed}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChipBusy}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusChipText}" FontSize="13" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChipReady}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsChipFailed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsChipBusy}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="4" Margin="0,0,2,0" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.YouTube.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{DynamicResource L_MoveUp}"
                                                AutomationProperties.Name="{DynamicResource L_MoveUp}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Width" Value="26"/>
                                                    <Setter Property="Height" Value="26"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE70E;"/>
                                        </Button>
                                        <Button Grid.Column="5" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.YouTube.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{DynamicResource L_MoveDown}"
                                                AutomationProperties.Name="{DynamicResource L_MoveDown}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Width" Value="26"/>
                                                    <Setter Property="Height" Value="26"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE70D;"/>
                                        </Button>
                                        <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.YouTube.RemoveCachedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{DynamicResource L_Remove}">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIconStyle}" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                            <TextBlock Grid.Row="3" Text="{DynamicResource L_YtEmpty}" FontSize="15" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding YouTube.HasDownloaded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- A filter that hides everything says so, instead of showing the
                                 "nothing downloaded yet" line, which would be a lie. -->
                            <TextBlock Grid.Row="3" Text="{DynamicResource L_SearchNoMatch}" FontSize="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding YouTube.FilteredEmptyVisibility}"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,4,0">

                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_YtCacheTitle}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- One place for both caches: the total, the previews and the two clear actions. -->
                            <TextBlock Text="{Binding YouTube.CacheSizeText}" FontSize="15.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding YouTube.SearchCacheSizeText}" FontSize="15.5" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <CheckBox IsChecked="{Binding YouTube.CacheEnabled}" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource L_YtCacheEnabled}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{Binding YouTube.CacheHintText}" FontSize="13.5" TextWrapping="Wrap"
                                       Margin="30,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                       ToolTip="{Binding YouTube.CachePathText}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{DynamicResource L_YtClearSearchCache}"
                                        Command="{Binding YouTube.ClearSearchCacheCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="8,4" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource L_YtClearDownloaded}"
                                        Command="{Binding YouTube.ClearDownloadedCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="8,4"/>
                            </WrapPanel>
                            <Button Content="{DynamicResource L_YtOpenFolder}"
                                    Command="{Binding YouTube.OpenMusicFolderCommand}"
                                    Style="{StaticResource SubtleButtonStyle}" Padding="10,5" Margin="0,8,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- The state leads; the path is a tooltip detail, not a headline. -->
                            <TextBlock Text="{Binding YouTube.YtDlpStatusText}" FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                       ToolTip="{Binding YouTube.YtDlpPath}"/>
                            <ProgressBar Value="{Binding YouTube.InstallProgress, Mode=OneWay}" Maximum="1"
                                         Height="4" Margin="0,8,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding YouTube.IsInstalling}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <!-- One button that follows the state; gone entirely when up to date. -->
                            <Button Content="{Binding YouTube.YtDlpActionText}"
                                    Command="{Binding YouTube.InstallYtDlpCommand}"
                                    Padding="10,5" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding YouTube.YtDlpActionVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The TikTok page. One column on purpose: a link in, a file out. The field and the cache
             card are pinned, so the list is the only thing that scrolls. -->
        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsTikTokPage}" Value="True"/>
                                <Condition Binding="{Binding IsFocusMode}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                    <!-- The same shape as the YouTube field: the box takes the width, the buttons
                         dock to its right, and the explanation sits underneath. Two sections that
                         ask for a link should not look like two different programs. -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" MinWidth="96" Margin="8,0,0,0"
                                Content="{DynamicResource L_Cancel}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding TikTok.CancelDownloadCommand}"
                                Visibility="{Binding TikTok.CancelVisible}"/>
                        <Button DockPanel.Dock="Right" MinWidth="112" Margin="8,0,0,0"
                                Content="{DynamicResource L_TikTokDownload}"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding TikTok.AddLinkCommand}"/>
                        <Grid>
                            <TextBox Text="{Binding TikTok.InputUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}" MaxLength="200"
                                     AcceptsReturn="False" Padding="10,6,36,6"
                                     AutomationProperties.Name="{DynamicResource L_TikTokInputHint}"/>
                            <!-- The cross clears the field itself; nothing else happens. -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Style="{StaticResource FieldClearButtonStyle}"
                                    Command="{Binding TikTok.ClearInputCommand}"
                                    Visibility="{Binding TikTok.InputClearVisible}"
                                    ToolTip="{DynamicResource L_ClearInput}"
                                    AutomationProperties.Name="{DynamicResource L_ClearInput}">
                                <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE711;"/>
                            </Button>
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource L_TikTokSearchHint}" FontSize="17" TextWrapping="Wrap"
                               Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ProgressBar Value="{Binding TikTok.Progress, Mode=OneWay}" Maximum="1" Height="4"
                                 Margin="0,10,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TikTok.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding TikTok.StatusText}" FontSize="14" TextWrapping="Wrap"
                               Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TikTok.StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- The cache card sits between the field and the list, as the second of the two
                 pinned rows: clearing is a decision, not something to scroll to. -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TikTok.CacheSizeText}" FontSize="15.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TikTok.CacheHintText}" FontSize="15.5" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource L_TikTokClearCache}" Padding="12,6"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding TikTok.ClearCacheCommand}"/>
                        <Button Content="{DynamicResource L_YtOpenFolder}" Margin="6,0,0,0" Padding="12,6"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding TikTok.OpenMusicFolderCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shown only after the network refused a request, never as a standing banner: telling
                 people to check their connection while everything works is noise. The guide keeps
                 the single full explanation; here it is one sentence, the entry button and a cross,
                 because advice nobody asked for must always be dismissible. -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0"
                    Visibility="{Binding TikTok.NetworkHintVisible}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The cross sits in the corner the eye checks first, the way every other
                         dismissible panel in the window does it. -->
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FieldClearButtonStyle}"
                                Command="{Binding TikTok.DismissNetworkHintCommand}"
                                ToolTip="{DynamicResource L_CloseDialog}"
                                AutomationProperties.Name="{DynamicResource L_CloseDialog}">
                            <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE8BB;"/>
                        </Button>
                        <TextBlock Text="{DynamicResource L_TikTokNetworkTitle}" FontSize="15.5"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{DynamicResource L_TikTokNetworkBody}" FontSize="15.5"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource L_TikTokTracksTitle}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Height="26" MinWidth="26" CornerRadius="13"
                                Background="{DynamicResource DropAreaBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding TikTok.TrackCountNumber}" FontSize="16"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <!-- The filter narrows the view only: the counter stays a fact about the whole
                         list, and the drag order is still applied to the real collection. -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox Text="{Binding TikTok.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBoxStyle}" MaxLength="200"
                                 AcceptsReturn="False" Padding="34,5,34,5"
                                 AutomationProperties.Name="{DynamicResource L_SearchTracksHint}"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIconStyle}" FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="11,0,0,0" IsHitTestVisible="False"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                Style="{StaticResource FieldClearButtonStyle}"
                                Command="{Binding TikTok.ClearFilterCommand}"
                                Visibility="{Binding TikTok.FilterClearVisible}"
                                ToolTip="{DynamicResource L_ClearInput}"
                                AutomationProperties.Name="{DynamicResource L_ClearInput}">
                            <TextBlock Style="{StaticResource SymbolIconStyle}" Text="&#xE711;"/>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding TikTok.FilteredTracks}" Background="Transparent"
                             SelectedItem="{Binding TikTok.SelectedTrack, Mode=TwoWay}"
                             BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource TrackListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="TikTokList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TikTokList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="TikTokList_PreviewMouseLeftButtonUp"
                             DragOver="TikTokList_DragOver"
                             DragLeave="TikTokList_DragLeave"
                             Drop="TikTokList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding TooltipText}" MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Insertion line shown while a row is dragged over this one. -->
                                    <Border Grid.ColumnSpan="8" Height="2" CornerRadius="1"
                                            VerticalAlignment="Top" Margin="-8,-6,-8,0"
                                            Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDropTarget}" Value="True"/>
                                                            <Condition Binding="{Binding IsDropTargetAbove}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Grid.ColumnSpan="8" Height="2" CornerRadius="1"
                                            VerticalAlignment="Bottom" Margin="-8,0,-8,-6"
                                            Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDropTarget}" Value="True"/>
                                                            <Condition Binding="{Binding IsDropTargetAbove}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center"
                                            Background="{DynamicResource OverlayBrush}">
                                        <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}" FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <!-- The same two lines the playlist uses: a name and a second line that
                                         says what the row is doing. The folder path is deliberately left
                                         out here: every row lives in Music\TikTok, so it would repeat the
                                         same sentence down the whole list. -->
                                    <Grid Grid.Column="1" Margin="5,0,12,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- The pencil swaps the label for a field: the name changes in
                                             this list only, the file on disk keeps its own name. -->
                                        <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding TitleVisibility}"/>
                                        <TextBox x:Name="RenameBox" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBoxStyle}" MaxLength="200"
                                                 AcceptsReturn="False" FontSize="15" Padding="6,2"
                                                 Visibility="{Binding EditVisibility}"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostFocus="RenameBox_LostFocus"
                                                 AutomationProperties.Name="{DynamicResource L_RenameTrack}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding SubtitleText}" FontSize="14"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Visibility="{Binding SubtitleVisible}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource SymbolIconStyle}" FontSize="13"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding DurationText}" FontSize="13.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="3" Background="{DynamicResource ControlBackgroundBrush}"
                                            CornerRadius="4" Padding="6,3" Margin="0,0,7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Extension}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Border>

                                    <!-- Play lives in the row header of the whole list, exactly as in the
                                         playlist: a click on the row already starts it, so a second button
                                         inside the row would only ask the same question twice. -->
                                    <Button Grid.Column="4" Margin="0,0,2,0" Click="TikTokEditClick"
                                            ToolTip="{DynamicResource L_RenameTrack}"
                                            AutomationProperties.Name="{DynamicResource L_RenameTrack}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Width" Value="26"/>
                                                <Setter Property="Height" Value="26"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="13" Text="&#xE70F;"/>
                                    </Button>
                                    <Button Grid.Column="5" Margin="0,0,2,0"
                                            Command="{Binding DataContext.TikTok.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="{DynamicResource L_MoveUp}"
                                            AutomationProperties.Name="{DynamicResource L_MoveUp}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Width" Value="26"/>
                                                <Setter Property="Height" Value="26"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE70E;"/>
                                    </Button>
                                    <Button Grid.Column="6" Margin="0,0,6,0"
                                            Command="{Binding DataContext.TikTok.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="{DynamicResource L_MoveDown}"
                                            AutomationProperties.Name="{DynamicResource L_MoveDown}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Width" Value="26"/>
                                                <Setter Property="Height" Value="26"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Style="{StaticResource SymbolIconStyle}" FontSize="12.5" Text="&#xE70D;"/>
                                    </Button>
                                    <Button Grid.Column="7" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.TikTok.RemoveCachedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="{DynamicResource L_Remove}"
                                            AutomationProperties.Name="{DynamicResource L_Remove}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIconStyle}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="{DynamicResource L_TikTokEmpty}" FontSize="16"
                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TikTok.HasTracks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Text="{DynamicResource L_SearchNoMatch}" FontSize="16"
                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding TikTok.FilteredEmptyVisibility}"/>
                </Grid>
            </Border>
        </Grid>
        <!-- The start screen. It answers one question — where does the music come from today —
             and nothing else. The tiles carry the only numbers in the app that are about music
             waiting, never about work done. -->
        <Grid Grid.Row="1" Margin="20,4,20,8" Visibility="{Binding HomePageVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,2,0,20">
                <TextBlock Text="{Binding GreetingText}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource L_HomeSubtitle}" FontSize="15" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource HomeTileStyle}"
                        Command="{Binding ShowPlaylistCommand}">
                    <StackPanel>
                        <Grid Height="30" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}" FontSize="24"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource L_HomeMyFiles}" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_HomeMyFilesHint}" FontSize="17" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding HomeTracksMeta}" FontSize="15.5" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource HomeTileStyle}"
                        Command="{Binding ShowYouTubeCommand}">
                    <StackPanel>
                        <Grid Height="30" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE714;" Style="{StaticResource SymbolIconStyle}" FontSize="24"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource L_HomeYouTube}" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_HomeYouTubeHint}" FontSize="17" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding HomeYouTubeMeta}" FontSize="15.5" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource HomeTileStyle}"
                        Command="{Binding ShowTikTokCommand}">
                    <StackPanel>
                        <!-- A drawn phone, not a glyph: the icon set has no vertical video, and
                             a square "video" glyph next to YouTube read as the same thing twice. -->
                        <Grid HorizontalAlignment="Left" Width="20" Height="30">
                            <Border CornerRadius="4" BorderThickness="1.5" Background="Transparent"
                                    BorderBrush="{DynamicResource AccentBrush}"/>
                            <Polygon Points="7,10 7,20 14,15" Fill="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource L_HomeTikTok}" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_HomeTikTokHint}" FontSize="17" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding HomeTikTokMeta}" FontSize="15.5" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Focus is the headline case for this app, so it sits on the start screen and not
                 only in the title bar. Settings is a visit, not a source, hence the low row. -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource HomeTileStyle}" Padding="20,16"
                        Command="{Binding ToggleFocusModeCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25CE;" FontSize="26"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_HomeFocus}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_HomeFocusHint}" FontSize="16" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource HomeTileStyle}" Padding="20,16"
                        Command="{Binding ShowSettingsCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" Style="{StaticResource SymbolIconStyle}" FontSize="20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_HomeSettings}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_HomeSettingsHint}" FontSize="15" Margin="0,3,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- The lower half of the hub is not decoration: it offers the one action that needs
                 no decision. A playing track is named; a stopped app offers to pick up the track
                 that is already selected. -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,16,0,0"
                    VerticalAlignment="Bottom" Visibility="{Binding NowPlayingCardVisible}">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="9"
                            Background="{DynamicResource DropAreaBrush}">
                        <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolIconStyle}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayingSourceText}" FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding PlayingTrackText}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackPositionText}" FontSize="14"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,16,0,0"
                    VerticalAlignment="Bottom" Visibility="{Binding ContinueCardVisible}">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Command="{Binding StartCommand}"
                            Style="{StaticResource AccentButtonStyle}" Padding="18,10" FontSize="16"
                            Content="{DynamicResource L_HomeContinue}" VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="9"
                            Background="{DynamicResource DropAreaBrush}">
                        <TextBlock Text="&#xE768;" Style="{StaticResource SymbolIconStyle}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_HomeContinueHint}" FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding ContinueTrackText}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Focus mode: nothing to choose, only what is happening. The way in is the tile on the
             start screen; the way out sits directly under the card, where the eye already is. -->
        <Grid Grid.Row="1" Panel.ZIndex="5" Margin="20,4,20,8" Visibility="{Binding FocusPanelVisible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource CardStyle}" Padding="28" MaxWidth="720">
                    <StackPanel>
                        <TextBlock Text="{Binding PlayingSourceText}" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding PlayingTrackText}" FontSize="24" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PlaybackProgress, Mode=OneWay}"
                                     Height="5" Margin="0,18,0,0"/>
                        <TextBlock Text="{Binding PlaybackPositionText}" FontSize="14.5" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_FocusHint}" FontSize="16" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,18,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <!-- A dead end is named, not clicked into: Start is already disabled here,
                             and this line explains why without leaving the scene. -->
                        <TextBlock Text="{DynamicResource L_FocusNeedMusic}" FontSize="18" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,18,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding FocusNeedsMusicVisible}"/>
                    </StackPanel>
                </Border>
                <!-- The exit sits under the card, not in the title bar: leaving a mode is part of
                     that mode, not part of the window. -->
                <Button Command="{Binding ToggleFocusModeCommand}" Content="{DynamicResource L_FocusExit}"
                        Style="{StaticResource SubtleButtonStyle}" FontSize="16" Padding="18,10"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        AutomationProperties.Name="{DynamicResource L_FocusExit}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                Visibility="{Binding FocusChromeVisible}">
                <Button Click="AboutClick" Style="{StaticResource SubtleButtonStyle}" Padding="10,5"
                        AutomationProperties.Name="{DynamicResource L_About}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SymbolIconStyle}" FontSize="15"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource L_About}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenLogsCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="10,5"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE838;" Style="{StaticResource SymbolIconStyle}" FontSize="15"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource L_Logs}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="ResetClick" Style="{StaticResource DangerButtonStyle}" Padding="10,5"
                        Margin="8,0,0,0" IsEnabled="{Binding CanReset}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE777;" Style="{StaticResource SymbolIconStyle}" FontSize="15" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource L_Reset}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" FontSize="15.5" TextWrapping="Wrap" MaxHeight="44"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding NowPlayingText}" FontSize="13.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding TogglePauseCommand}" MinWidth="118" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="ToolTip" Value="{DynamicResource L_PauseHint}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="ToolTip" Value="{DynamicResource L_ResumeHint}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PauseResumeGlyph}" Style="{StaticResource SymbolIconStyle}"
                                   FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding PauseResumeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="{DynamicResource L_Stop}" Command="{Binding StopCommand}"
                        ToolTip="{DynamicResource L_StopHint}"
                        Style="{StaticResource SubtleButtonStyle}" MinWidth="104" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource L_Start}" Command="{Binding StartCommand}"
                        ToolTip="{DynamicResource L_StartHint}"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="132"
                        Visibility="{Binding StartButtonVisible}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
