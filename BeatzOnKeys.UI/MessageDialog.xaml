<Window x:Class="BeatzOnKeys.UI.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeatzOnKeys"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,14" Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <TextBlock Grid.Row="1" x:Name="MessageText" Margin="18,0,18,18"
                       FontSize="16.5" TextWrapping="Wrap" LineHeight="23"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <!-- The release notes get their own scrollable block; they can be long. -->
            <Border Grid.Row="2" x:Name="NotesHost" Margin="18,0,18,16" MaxHeight="260"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Blocks are built in code so headings, bullets and bold keep their shape. -->
                    <StackPanel x:Name="NotesPanel"/>
                </ScrollViewer>
            </Border>


            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="18,0,18,16">
                <Button x:Name="BtnNo" Style="{StaticResource SubtleButtonStyle}" FontSize="17"
                        MinWidth="96" Margin="0,0,8,0" Click="BtnNo_Click"/>
                <Button x:Name="BtnYes" Style="{StaticResource AccentButtonStyle}" FontSize="17"
                        MinWidth="96" Click="BtnYes_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
